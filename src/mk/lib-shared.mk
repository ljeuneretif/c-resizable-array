RA_OBJ_SHARED := $(RA_SRC_FILES:$(SRC_DIR)/%.c=$(BUILD_PATH)/%.shared.o)

RA_SHARED_CFLAGS := -fPIC $(RA_CFLAGS)
RA_SHARED_CPPFLAGS := $(RA_CPPFLAGS)
RA_SHARED_LDFLAGS := -shared -Wl,-soname,$(RA_LIB_SHARED_SONAME) $(RA_LDFLAGS)
RA_SHARED_LDLIBS := $(RA_LDLIBS)

RA_LIB_SHARED_FILE_BUILD := $(BUILD_PATH)/$(RA_LIB_SHARED_FILENAME)
RA_LIB_SHARED_SONAME_BUILD := $(BUILD_PATH)/$(RA_LIB_SHARED_SONAME)
RA_LIB_SHARED_VERSIONNED_BUILD := $(BUILD_PATH)/$(RA_LIB_SHARED_VERSIONNED_FILENAME)

RA_LIB_SHARED_FILE_OUT := $(OUT_DIR)/$(RA_LIB_SHARED_FILENAME)
RA_LIB_SHARED_SONAME_OUT := $(OUT_DIR)/$(RA_LIB_SHARED_SONAME)
RA_LIB_SHARED_VERSIONNED_OUT := $(OUT_DIR)/$(RA_LIB_SHARED_VERSIONNED_FILENAME)



$(RA_LIB_SHARED_FILE_BUILD): $(RA_LIB_SHARED_SONAME_BUILD)
	ln -sf $(notdir $<) $@

$(RA_LIB_SHARED_SONAME_BUILD): $(RA_LIB_SHARED_VERSIONNED_BUILD)
	ln -sf $(notdir $<) $@

$(RA_LIB_SHARED_VERSIONNED_BUILD): $(RA_OBJ_SHARED)
	$(CC) $(RA_SHARED_LDFLAGS) -o $@ $^ $(RA_SHARED_LDLIBS)

$(RA_OBJ_SHARED): $(BUILD_PATH)/%.shared.o: $(BUILD_PATH)/%.c
	$(CC) $(RA_SHARED_CFLAGS) $(RA_SHARED_CPPFLAGS) -o $@ -c $<
