RA_HDR_OUT := $(OUT_DIR)/$(RA_LIB_NAME).h

RA_LIB_SHARED_FILE_OUT := $(OUT_DIR)/$(RA_LIB_SHARED_FILENAME)
RA_LIB_SHARED_SONAME_OUT := $(OUT_DIR)/$(RA_LIB_SHARED_SONAME)
RA_LIB_SHARED_VERSIONNED_OUT := $(OUT_DIR)/$(RA_LIB_SHARED_VERSIONNED_FILENAME)

RA_LIB_STATIC_FILE_OUT := $(OUT_DIR)/$(RA_LIB_STATIC_FILENAME)

PKGCONFIG_OUT := $(OUT_DIR)/$(PKGCONFIG_FILE)



.PHONY: out
out: $(RA_HDR_OUT) \
	$(RA_LIB_SHARED_FILE_OUT) $(RA_LIB_SHARED_SONAME_OUT) $(RA_LIB_SHARED_VERSIONNED_OUT) \
	$(RA_LIB_STATIC_FILE_OUT) \
	$(PKGCONFIG_OUT)


$(RA_HDR_OUT): $(RA_HDR_BUILD) | $(OUT_DIR)
	cp $< $@


$(RA_LIB_SHARED_VERSIONNED_OUT): $(RA_LIB_SHARED_VERSIONNED_BUILD) | $(OUT_DIR)
	cp $< $@

$(RA_LIB_SHARED_SONAME_OUT): $(RA_LIB_SHARED_VERSIONNED_OUT)
	ln -sf $(notdir $<) $@

$(RA_LIB_SHARED_FILE_OUT): $(RA_LIB_SHARED_SONAME_OUT)
	ln -sf $(notdir $<) $@


$(RA_LIB_STATIC_FILE_OUT): $(RA_LIB_STATIC_FILE_BUILD) | $(OUT_DIR)
	cp $< $@


$(PKGCONFIG_OUT): $(PKGCONFIG_BUILD) | $(OUT_DIR)
	cp $< $@
