# Copy the files ready to be distributed.
.PHONY: out
out: $(RA_LIB_SHARED_FILE_OUT) $(RA_LIB_SHARED_SONAME_OUT) $(RA_LIB_SHARED_VERSIONNED_OUT) $(RA_LIB_STATIC_FILE_OUT) $(PKGCONFIG_OUT)


$(RA_LIB_SHARED_VERSIONNED_OUT): $(RA_LIB_SHARED_VERSIONNED_BUILD) | $(OUT_DIR)
	cp $< $@

$(RA_LIB_SHARED_SONAME_OUT): $(RA_LIB_SHARED_VERSIONNED_OUT)
	ln -sf $(notdir $<) $@

$(RA_LIB_SHARED_FILE_OUT): $(RA_LIB_SHARED_SONAME_OUT)
	ln -sf $(notdir $<) $@


$(RA_LIB_STATIC_FILE_OUT): $(RA_LIB_STATIC_FILE_BUILD) | $(OUT_DIR)
	cp $< $@


$(PKGCONFIG_OUT): $(PKGCONFIG_BUILD) | $(OUT_DIR)
	cp $< $@
