AR = ar
ARFLAGS = crsv


RA_OBJ_STATIC := $(RA_SRC_FILES:$(SRC_DIR)/%.c=$(BUILD_PATH)/%.static.o)

RA_STATIC_CFLAGS := $(RA_CFLAGS)
RA_STATIC_CPPFLAGS := $(RA_CPPFLAGS)

RA_LIB_STATIC_FILE_BUILD := $(BUILD_PATH)/$(RA_LIB_STATIC_FILENAME)

RA_LIB_STATIC_FILE_OUT := $(OUT_DIR)/$(RA_LIB_STATIC_FILENAME)



$(RA_LIB_STATIC_FILE_BUILD): $(RA_OBJ_STATIC)
	$(AR) $(ARFLAGS) $@ $^

$(RA_OBJ_STATIC): $(BUILD_PATH)/%.static.o: $(BUILD_PATH)/%.c
	$(CC) $(RA_STATIC_CFLAGS) $(RA_STATIC_CPPFLAGS) -o $@ -c $<
